# Copy this to .env.local and fill in your values

# Shared access password for the app (Corinne uses this to log in)
DASHBOARD_PASSWORD=your_password_here

# Secret for signing auth cookies (any long random string — never share this)
JWT_SECRET=your_random_secret_here

# Anthropic API key (powers the AI coach)
ANTHROPIC_API_KEY=sk-ant-...

# Apify API token (powers the Job Board Scraper)
APIFY_TOKEN=apify_api_...

# Neon PostgreSQL connection string (optional — only needed if using DB-backed features)
# DATABASE_URL=postgres://user:pass@host/dbname?sslmode=require

# Optional: override Claude model
# CLAUDE_MODEL=claude-sonnet-4-6
